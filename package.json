{
	"name": "automatstudio",
	"version": "0.1.0",
	"engines": {
		"node": ">=18.0.0",
		"pnpm": ">=8.0.0"
	},
	"private": true,
	"scripts": {
		"dev": "pnpm i && DATOCMS_ENVIRONMENT=dev node server.js & npm run barrel:watch & DATOCMS_ENVIRONMENT=dev graphql-codegen --watch",
		"dev:test": "DATOCMS_ENVIRONMENT=dev npm run dev",
		"build": "next build && npm run postbuild",
		"codegen": "graphql-codegen",
		"start": "NODE_ENV=production node server.js",
		"lint": "next lint",
		"preview": "npm run build && npm run start",
		"barrel": "node ./lib/scripts/barrel",
		"barrel:watch": "watch 'node ./lib/scripts/barrel' ./components",
		"postbuild": "next-sitemap",
		"logs": "tsx ./lib/scripts/railway_logs.ts"
	},
	"dependencies": {
		"@apollo/client": "^3.7.15",
		"@datocms/cma-client": "3.0.1",
		"@datocms/cma-client-browser": "3.0.1",
		"@datocms/cma-client-node": "^3.0.2",
		"@graphql-codegen/typescript-react-apollo": "^3.3.7",
		"@next/env": "^13.4.4",
		"@svgr/webpack": "^6.5.1",
		"archiver": "^6.0.1",
		"async-promise-batch": "1.0.5",
		"classnames": "^2.3.2",
		"cryptr": "^6.3.0",
		"date-fns": "2.29.3",
		"dato-nextjs-utils": "github:bebejane/dato-nextjs-utils",
		"datocms-structured-text-utils": "^2.0.4",
		"dotenv": "^16.3.1",
		"glob": "^10.3.10",
		"graphql": "^16.6.0",
		"graphql-tag": "^2.12.6",
		"linebyline": "^1.3.0",
		"markdown-truncate": "^1.1.0",
		"multer": "1.4.5-lts.1",
		"nanoid": "^5.0.1",
		"next": "^13.5.3",
		"next-auth": "^4.23.2",
		"next-seo": "^5.15.0",
		"next-sitemap": "^3.1.55",
		"nextjs-cors": "^2.1.2",
		"node-cron": "^3.0.2",
		"nodejs-file-downloader": "^4.12.1",
		"react": "^18.2.0",
		"react-datocms": "^4.1.3",
		"react-dom": "^18.2.0",
		"react-markdown": "^8.0.7",
		"remark-breaks": "^3.0.3",
		"remark-gfm": "^3.0.1",
		"rooks": "^7.14.1",
		"sass": "^1.62.1"
	},
	"devDependencies": {
		"@graphql-codegen/cli": "^2.16.5",
		"@graphql-codegen/import-types-preset": "^2.2.6",
		"@graphql-codegen/introspection": "^2.2.3",
		"@graphql-codegen/typed-document-node": "^2.3.13",
		"@graphql-codegen/typescript": "^2.8.8",
		"@graphql-codegen/typescript-document-nodes": "^2.3.13",
		"@graphql-codegen/typescript-graphql-files-modules": "^2.2.1",
		"@graphql-codegen/typescript-operations": "^2.5.13",
		"@graphql-codegen/typescript-resolvers": "^2.7.13",
		"@types/archiver": "^5.3.3",
		"@types/graphql": "^14.5.0",
		"@types/multer": "^1.4.8",
		"@types/node": "^18.16.16",
		"@types/react": "^18.2.8",
		"apollo": "^2.34.0",
		"chalk": "^5.3.0",
		"eslint": "^8.42.0",
		"eslint-config-next": "^12.3.4",
		"eslint-plugin-jsx-a11y": "^6.7.1",
		"typescript": "^4.9.5",
		"watch": "^1.0.2"
	}
}
